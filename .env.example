# Copy to .env at the repository root. Never commit actual credentials.
# Use plain KEY=value lines; no shell commands, export prefix or surrounding quotes.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=medicine_safety_checker

# Keep false for an existing Atlas dataset to avoid demo seed writes.
# Set true to initialize/refresh demo medicines, interactions and patients.
APP_SEED_ENABLED=false

# Optional first doctor account. An existing username is never reset.
MSC_DOCTOR_USERNAME=doctor
MSC_DOCTOR_PASSWORD=<choose-at-least-12-characters>
MSC_DOCTOR_NAME=Demo Doctor
MSC_DOCTOR_SPECIALISATION=General Medicine
MSC_ALLOW_DEMO_PASSWORD=false
